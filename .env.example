# Supabase — required
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never NEXT_PUBLIC_

# Booking confirmation email (optional). Without these, bookings still succeed
# and the guest gets the WhatsApp link — email is simply skipped.
RESEND_API_KEY=
BOOKING_FROM_EMAIL=bookings@yourdomain.com

# Razorpay — deposit payments (Phase 9). KEY_ID is the publishable key and is
# returned to the browser through the API response (never NEXT_PUBLIC_). KEY_SECRET
# and WEBHOOK_SECRET are SERVER ONLY — never expose them to client code.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=            # server only, never NEXT_PUBLIC_
RAZORPAY_WEBHOOK_SECRET=        # server only; webhook fails closed if unset
