# Supabase — required
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never NEXT_PUBLIC_

# Staff portal switch (see src/lib/launch-server.ts). Set to true for local development
# so /login, /pos, /stays, /reception and /api/channel/* exist. Leave it UNSET on
# the public Netlify deployment — the portfolio site ships without the portal.
STAFF_PORTAL_ENABLED=true

# Booking confirmation email (optional). Without these, bookings still succeed
# and the guest gets the WhatsApp link — email is simply skipped.
RESEND_API_KEY=
BOOKING_FROM_EMAIL=bookings@yourdomain.com
